# --- Gemma (required) ---
# Google AI Studio → Get API key
GEMINI_API_KEY=paste-your-key-here
# Model used by the app
GEMMA_MODEL=gemma-4-31b-it
# Used automatically for a few minutes when the main model is down on Google's side ("off" to disable)
GEMMA_FALLBACK_MODEL=gemma-4-26b-a4b-it
# Quicker model for live voice conversation (the gap check still uses GEMMA_MODEL)
GEMMA_FAST_MODEL=gemma-4-26b-a4b-it
# Backup for live conversation when the fast model is busy (its own free quota, so many visitors at once still get answers; "off" to disable)
GEMMA_FAST_FALLBACK=gemini-2.5-flash-lite
# Voice input (Talk button) only: speech to text. Gemma 4 31B can't take audio.
TRANSCRIBE_MODEL=gemini-3.5-flash
# (if its free daily limit runs out, voice input switches to gemini-2.5-flash, then gemini-2.5-flash-lite)
# The cofounder's spoken voice (text to speech). The free tier allows ~10 clips a day per model,
# so the app goes down this list when one runs out. Leave unset for the default list.
# TTS_MODEL=gemini-3.8-flash-tts,gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
TTS_VOICE=Charon
# Live voice (the Live toggle, on by default): real-time listening and talking with Gemini Live.
# Gemma still runs every skill behind it. Same GEMINI_API_KEY; the browser only gets a short-lived token.
LIVE_MODEL=gemini-3.8-live

# --- Supabase (optional, but needed to save evidence, tests and reviews) ---
# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service-role-key-here

# --- Optional ---
# Set this before sharing a deployed link; the app will ask for it once.
# ACCESS_CODE=choose-a-code

# --- Gmail tasks (optional) ---
# Google Cloud → OAuth client (Web application). See "Connect Gmail" in the README.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Your timezone, for task dates and "today" (default Asia/Karachi)
# TIMEZONE=Asia/Karachi

# Country code added to local numbers that start with 0 (People panel, WhatsApp). Default 92 (Pakistan).
# DEFAULT_COUNTRY_CODE=92

# --- WhatsApp bot (optional). See "Connect WhatsApp" in the README. ---
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# Only these numbers can talk to Inovo (comma-separated, with country code)
# WHATSAPP_OWNER_NUMBER=923001234567
# Approved template (body: {{1}}) so the morning brief arrives even after 24 h of silence
# WHATSAPP_BRIEF_TEMPLATE=
# WHATSAPP_BRIEF_TEMPLATE_LANG=en
# Protects the daily brief that Vercel Cron triggers (vercel.json)
# CRON_SECRET=

# Public demo: sample Inovix tasks, meetings, people and emails instead of your real ones.
# On automatically on Vercel, off on your laptop. Force it with on/off.
# DEMO_MODE=on
